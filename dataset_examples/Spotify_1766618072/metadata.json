{
  "id": "Spotify_1766618072",
  "description": " | Flow: The Off-Canvas Settings | Style: Spotify Immersive Dark (Vibe: Entertainment, media-heavy. Rules: Pure black (#000000) background. Cards use 'Neutral-900'. Interactive elements change brightness on hover. Use broad grids for images. Accent color is a punchy Green or Brand color.) | Context: Smart Home IoT Controller (Security Camera Feed, Energy Usage Graph, Device Settings)",
  "ground_truth_code": "<script setup>\nimport { ref, reactive, computed } from 'vue';\n\n// State Management\nconst isSidebarOpen = ref(false);\nconst isDark = ref(true);\nconst cameraActive = ref(true);\n\n// Mock Data for IoT Context\nconst devices = reactive([\n  { id: 1, name: 'Living Room Lights', status: 'On', icon: '\ud83d\udca1' },\n  { id: 2, name: 'Thermostat', status: '72\u00b0F', icon: '\ud83c\udf21\ufe0f' },\n  { id: 3, name: 'Smart Lock', status: 'Locked', icon: '\ud83d\udd12' },\n  { id: 4, name: 'Humidifier', status: 'Off', icon: '\ud83d\udca7' }\n]);\n\nconst energyData = [40, 70, 30, 85, 50, 90, 60];\n\n// Actions\nconst toggleSidebar = () => {\n  isSidebarOpen.value = !isSidebarOpen.value;\n};\n\nconst toggleTheme = () => {\n  isDark.value = !isDark.value;\n};\n\nconst toggleCamera = () => {\n  cameraActive.value = !cameraActive.value;\n};\n\n// Computed Classes\nconst themeClass = computed(() => isDark.value ? 'theme-dark' : 'theme-light');\n</script>\n\n<template>\n  <div class=\"app-container\" :class=\"[themeClass, { 'sidebar-active': isSidebarOpen }]\">\n    \n    <!-- Main Content Wrapper (Shifts Left) -->\n    <div class=\"main-content\" data-testid=\"main-content-wrapper\">\n      \n      <!-- Header -->\n      <header class=\"app-header\">\n        <div class=\"brand\">\n          <div class=\"logo-circle\"></div>\n          <h1 class=\"app-title\">HomeOS</h1>\n        </div>\n        <button \n          class=\"avatar-btn\" \n          @click=\"toggleSidebar\" \n          data-testid=\"avatar-btn\"\n          aria-label=\"Open Settings\"\n        >\n          <img src=\"https://api.dicebear.com/7.x/avataaars/svg?seed=Felix\" alt=\"User Avatar\" />\n        </button>\n      </header>\n\n      <!-- Dashboard Grid -->\n      <div class=\"dashboard-grid\">\n        \n        <!-- 1. Security Camera Feed -->\n        <div class=\"card camera-card\" data-testid=\"camera-card\">\n          <div class=\"card-header\">\n            <h3>Front Porch Cam</h3>\n            <div class=\"live-indicator\" v-if=\"cameraActive\">\n              <span class=\"blink\">\u25cf</span> LIVE\n            </div>\n            <div class=\"offline-indicator\" v-else>OFFLINE</div>\n          </div>\n          <div class=\"camera-feed\" :class=\"{ 'feed-off': !cameraActive }\">\n            <div v-if=\"cameraActive\" class=\"feed-overlay\">\n              <span>12:42:09 PM</span>\n            </div>\n            <div v-else class=\"feed-placeholder\">\n              <span>Camera Disabled</span>\n            </div>\n          </div>\n          <button \n            class=\"action-btn\" \n            @click=\"toggleCamera\" \n            data-testid=\"cam-toggle\"\n          >\n            {{ cameraActive ? 'Disable Feed' : 'Enable Feed' }}\n          </button>\n        </div>\n\n        <!-- 2. Energy Usage Graph -->\n        <div class=\"card energy-card\">\n          <h3>Energy Usage (kWh)</h3>\n          <div class=\"chart-container\">\n            <div \n              v-for=\"(val, index) in energyData\" \n              :key=\"index\" \n              class=\"bar\" \n              :style=\"{ height: val + '%' }\"\n              :title=\"val + '%'\"\n            ></div>\n          </div>\n          <div class=\"chart-labels\">\n            <span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>\n          </div>\n        </div>\n\n        <!-- 3. Smart Devices Grid -->\n        <div class=\"card devices-card\">\n          <h3>Active Devices</h3>\n          <div class=\"device-grid\">\n            <div \n              v-for=\"device in devices\" \n              :key=\"device.id\" \n              class=\"device-item\"\n              :data-testid=\"'device-' + device.id\"\n            >\n              <span class=\"device-icon\">{{ device.icon }}</span>\n              <div class=\"device-info\">\n                <span class=\"device-name\">{{ device.name }}</span>\n                <span class=\"device-status\">{{ device.status }}</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n    <!-- Off-Canvas Sidebar -->\n    <aside class=\"settings-sidebar\" :class=\"{ 'open': isSidebarOpen }\" data-testid=\"sidebar\">\n      <div class=\"sidebar-header\">\n        <h2>Settings</h2>\n        <button \n          class=\"close-btn\" \n          @click=\"toggleSidebar\" \n          data-testid=\"close-sidebar-btn\"\n        >\n          \u2715\n        </button>\n      </div>\n\n      <div class=\"sidebar-content\">\n        <div class=\"user-profile\">\n          <div class=\"big-avatar\">\n             <img src=\"https://api.dicebear.com/7.x/avataaars/svg?seed=Felix\" alt=\"Profile\" />\n          </div>\n          <h3>Alex Doe</h3>\n          <p>Admin Access</p>\n        </div>\n\n        <div class=\"setting-group\">\n          <label>Appearance</label>\n          <div class=\"setting-item\">\n            <span>Dark Mode</span>\n            <button \n              class=\"toggle-switch\" \n              :class=\"{ 'active': isDark }\"\n              @click=\"toggleTheme\" \n              data-testid=\"theme-toggle\"\n            >\n              <div class=\"toggle-knob\"></div>\n            </button>\n          </div>\n        </div>\n\n        <div class=\"setting-group\">\n          <label>System</label>\n          <div class=\"setting-item\">\n            <span>Notifications</span>\n            <button class=\"toggle-switch active\">\n              <div class=\"toggle-knob\"></div>\n            </button>\n          </div>\n          <div class=\"setting-item\">\n            <span>Remote Access</span>\n            <button class=\"toggle-switch\">\n              <div class=\"toggle-knob\"></div>\n            </button>\n          </div>\n        </div>\n        \n        <button class=\"logout-btn\" data-testid=\"logout-btn\">Log Out</button>\n      </div>\n    </aside>\n\n  </div>\n</template>\n\n<style scoped>\n/* \n  Theme Variables \n  Spotify Vibe: Pure Black, Neutral Grays, Punchy Green\n*/\n.theme-dark {\n  --bg-color: #000000;\n  --card-bg: #121212;\n  --text-primary: #FFFFFF;\n  --text-secondary: #B3B3B3;\n  --accent-color: #1DB954;\n  --border-color: #282828;\n  --hover-bg: #282828;\n}\n\n.theme-light {\n  --bg-color: #F0F2F5;\n  --card-bg: #FFFFFF;\n  --text-primary: #121212;\n  --text-secondary: #555555;\n  --accent-color: #1DB954;\n  --border-color: #DDDDDD;\n  --hover-bg: #E0E0E0;\n}\n\n* {\n  box-sizing: border-box;\n}\n\n.app-container {\n  background-color: var(--bg-color);\n  color: var(--text-primary);\n  min-height: 100vh;\n  width: 100vw;\n  overflow-x: hidden; /* Prevent horizontal scrollbars during transition */\n  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n  position: relative;\n  transition: background-color 0.3s ease, color 0.3s ease;\n}\n\n/* Main Content Layout Shift */\n.main-content {\n  width: 100%;\n  min-height: 100vh;\n  padding: 2rem;\n  transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);\n  background-color: var(--bg-color);\n}\n\n/* When sidebar is active, push main content left */\n.sidebar-active .main-content {\n  transform: translateX(-350px);\n  opacity: 0.6;\n  pointer-events: none; /* Disable interaction with dash when settings open */\n}\n\n/* Header */\n.app-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 2rem;\n}\n\n.brand {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n}\n\n.logo-circle {\n  width: 40px;\n  height: 40px;\n  background-color: var(--accent-color);\n  border-radius: 50%;\n}\n\n.avatar-btn {\n  background: none;\n  border: none;\n  cursor: pointer;\n  padding: 4px;\n  border-radius: 50%;\n  transition: transform 0.2s;\n}\n\n.avatar-btn:hover {\n  transform: scale(1.05);\n}\n\n.avatar-btn img {\n  width: 48px;\n  height: 48px;\n  border-radius: 50%;\n  border: 2px solid var(--card-bg);\n}\n\n/* Dashboard Grid */\n.dashboard-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 1.5rem;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n.card {\n  background-color: var(--card-bg);\n  border-radius: 12px;\n  padding: 1.5rem;\n  box-shadow: 0 4px 20px rgba(0,0,0,0.2);\n  transition: background-color 0.3s, transform 0.2s;\n}\n\n.card:hover {\n  background-color: var(--hover-bg);\n  transform: translateY(-2px);\n}\n\nh3 {\n  margin-top: 0;\n  margin-bottom: 1rem;\n  font-weight: 600;\n  font-size: 1.1rem;\n}\n\n/* Camera Card Specifics */\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 1rem;\n}\n\n.live-indicator {\n  color: #FF4444;\n  font-weight: bold;\n  font-size: 0.8rem;\n  display: flex;\n  align-items: center;\n  gap: 0.4rem;\n}\n\n.blink {\n  animation: blinker 1.5s linear infinite;\n}\n\n@keyframes blinker {\n  50% { opacity: 0; }\n}\n\n.camera-feed {\n  background-color: #000;\n  height: 200px;\n  border-radius: 8px;\n  position: relative;\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 1rem;\n}\n\n.feed-overlay {\n  position: absolute;\n  bottom: 10px;\n  right: 10px;\n  background: rgba(0,0,0,0.6);\n  color: #fff;\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 0.8rem;\n}\n\n.feed-off {\n  background-color: #222;\n}\n\n.feed-placeholder {\n  color: #555;\n}\n\n.action-btn {\n  width: 100%;\n  padding: 0.8rem;\n  background-color: var(--accent-color);\n  color: #000;\n  font-weight: bold;\n  border: none;\n  border-radius: 25px;\n  cursor: pointer;\n  transition: opacity 0.2s;\n}\n\n.action-btn:hover {\n  opacity: 0.9;\n}\n\n/* Energy Graph */\n.chart-container {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  height: 150px;\n  margin-bottom: 10px;\n  padding-top: 20px;\n}\n\n.bar {\n  width: 10%;\n  background-color: var(--accent-color);\n  border-radius: 4px;\n  transition: height 0.5s ease;\n  opacity: 0.8;\n}\n\n.bar:hover {\n  opacity: 1;\n}\n\n.chart-labels {\n  display: flex;\n  justify-content: space-between;\n  color: var(--text-secondary);\n  font-size: 0.85rem;\n  padding: 0 5px;\n}\n\n/* Device List */\n.device-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 1rem;\n}\n\n.device-item {\n  background-color: rgba(255,255,255,0.05);\n  padding: 1rem;\n  border-radius: 8px;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n.device-icon {\n  font-size: 1.5rem;\n}\n\n.device-info {\n  display: flex;\n  flex-direction: column;\n}\n\n.device-name {\n  font-size: 0.9rem;\n  font-weight: 500;\n}\n\n.device-status {\n  font-size: 0.8rem;\n  color: var(--text-secondary);\n}\n\n/* Sidebar Styles */\n.settings-sidebar {\n  position: fixed;\n  top: 0;\n  right: -350px; /* Hidden off-screen */\n  width: 350px;\n  height: 100%;\n  background-color: var(--card-bg);\n  border-left: 1px solid var(--border-color);\n  padding: 2rem;\n  transition: right 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);\n  z-index: 100;\n  box-shadow: -10px 0 30px rgba(0,0,0,0.5);\n}\n\n.settings-sidebar.open {\n  right: 0; /* Slide in */\n}\n\n.sidebar-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 2rem;\n}\n\n.close-btn {\n  background: none;\n  border: none;\n  color: var(--text-primary);\n  font-size: 1.5rem;\n  cursor: pointer;\n  padding: 0.5rem;\n}\n\n.user-profile {\n  text-align: center;\n  margin-bottom: 3rem;\n}\n\n.big-avatar img {\n  width: 100px;\n  height: 100px;\n  border-radius: 50%;\n  margin-bottom: 1rem;\n}\n\n.setting-group {\n  margin-bottom: 2.5rem;\n}\n\n.setting-group label {\n  display: block;\n  color: var(--text-secondary);\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  margin-bottom: 1rem;\n  font-weight: bold;\n}\n\n.setting-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 1rem;\n}\n\n/* Toggle Switch */\n.toggle-switch {\n  width: 50px;\n  height: 26px;\n  background-color: var(--border-color);\n  border-radius: 13px;\n  border: none;\n  position: relative;\n  cursor: pointer;\n  transition: background-color 0.3s;\n}\n\n.toggle-switch.active {\n  background-color: var(--accent-color);\n}\n\n.toggle-knob {\n  width: 20px;\n  height: 20px;\n  background-color: white;\n  border-radius: 50%;\n  position: absolute;\n  top: 3px;\n  left: 3px;\n  transition: left 0.3s;\n}\n\n.toggle-switch.active .toggle-knob {\n  left: 27px;\n}\n\n.logout-btn {\n  width: 100%;\n  padding: 1rem;\n  margin-top: 1rem;\n  background-color: transparent;\n  border: 1px solid var(--border-color);\n  color: var(--text-primary);\n  border-radius: 25px;\n  cursor: pointer;\n  transition: all 0.3s;\n}\n\n.logout-btn:hover {\n  border-color: var(--text-primary);\n}\n</style>",
